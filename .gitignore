# =============================================================================
# Claude Code (per-user)
# =============================================================================
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Sunnah.com hadith dump (~94 MB) — imported into SQL Server via tools/HadithImporter.
# Reference data, not source; never commit (would bloat history permanently).
.claude/HadithTable.sql
# API keys / secrets dropped into .claude/ — never commit.
.claude/apikey.txt

# =============================================================================
# Runtime upload storage — never commit user-supplied images / documents.
# The folder is created on demand by LocalFileStorage; keep it out of git.
# =============================================================================
src/LMS.WebAPI/wwwroot/uploads/
# But keep the .gitignore / .gitkeep scaffolding so the empty folder structure
# is preserved on a fresh clone (LocalFileStorage looks for these subfolders).
!src/LMS.WebAPI/wwwroot/uploads/**/.gitignore
!src/LMS.WebAPI/wwwroot/uploads/**/.gitkeep

# =============================================================================
# Angular production build output (lands in wwwroot during ./deploy/build-azure-bundle.ps1).
# We don't want the chunk-*.js / main-*.js / index.html etc. tracked in git —
# they're rebuilt from lms-angular/ on every deploy. The uploads/ folder above
# is the one exception.
# =============================================================================
src/LMS.WebAPI/wwwroot/*.js
src/LMS.WebAPI/wwwroot/*.css
src/LMS.WebAPI/wwwroot/*.html
src/LMS.WebAPI/wwwroot/*.ico
src/LMS.WebAPI/wwwroot/*.json
src/LMS.WebAPI/wwwroot/*.txt
src/LMS.WebAPI/wwwroot/browser/
# Static docs copied from lms-angular/public/docs/ during the prod build —
# canonical source lives in lms-angular/public/docs/, never edit here.
src/LMS.WebAPI/wwwroot/docs/

# =============================================================================
# Deploy artifacts — produced by ./deploy/build-azure-bundle.ps1 + smoke tests.
# Keep the deploy/ folder structure + scripts; never commit the binary bundles.
# =============================================================================
deploy/*.zip
deploy/sample-certificate.pdf
