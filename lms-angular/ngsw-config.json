{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.json", "/*.css", "/*.js", "/logo-header.webp", "/icons/**"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/*.(svg|webp|png|jpg|jpeg|gif|ico)",
          
          
          "/*.(woff|woff2|ttf|otf)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "quran",
      "urls": ["https://api.quran.com/api/v4/chapters**", "https://api.quran.com/api/v4/verses/by_chapter/**", "https://api.quran.com/api/v4/resources/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 1500, "maxAge": "90d" }
    },
    {
      "name": "hadith",
      "urls": ["/api/sunnah/collections**", "/api/sunnah/collections/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 20000, "maxAge": "90d" }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/swagger/**",
    "!/learn-arabic/**",
    "!/uploads/**",
    "!/health**"
  ]
}
