onfirming the booking","ur":"booking pakki karna"},{"ar":"خُطوطُ السَّفَر","tr":"khuṭūṭu s-safar","en":"travel airlines","ur":"airlines"},{"ar":"قَريب","tr":"qarīb","en":"near","ur":"qareeb"},{"ar":"فَتَحَ","tr":"fataḥa","en":"opened","ur":"khola"},{"ar":"غادَرَ","tr":"ghādara","en":"left","ur":"rawana hua"},{"ar":"طَعام","tr":"ṭaʿām","en":"food","ur":"khana"}],"quiz":[{"q":{"en":"What does أَهْلاً وَسَهْلاً mean?","ur":"أَهْلاً وَسَهْلاً ka matlab?","ar":"ما مَعْنى «أَهْلاً وَسَهْلاً»؟"},"options":["welcome","goodbye","thank you","sorry"],"answer":0,"options_ar":["عِبارَةُ تَرْحيبٍ","عِبارَةُ وَداعٍ","عِبارَةُ شُكْرٍ","عِبارَةُ اعْتِذارٍ"]},{"q":{"en":"What does إِقامَةٌ طَيِّبَة wish someone?","ur":"إِقامَةٌ طَيِّبَة kis cheez ki dua hai?","ar":"ماذا نَتَمَنّى لِشَخْصٍ حينَ نَقولُ «إِقامَةٌ طَيِّبَةٌ»؟"},"options":["A pleasant stay","A fast flight","A big bag","A cheap ticket"],"answer":0,"options_ar":["أَنْ يَسْعَدَ في إِقامَتِهِ","أَنْ تَكونَ الرِّحْلَةُ سَريعَةً","أَنْ تَكونَ الحَقيبَةُ كَبيرَةً","أَنْ تَكونَ التَّذْكِرَةُ رَخيصَةً"]},{"q":{"en":"Put in order: أَيْنَ / تَأْشيرَةُ / الخُروج","ur":"Tarteeb dein: أَيْنَ / تَأْشيرَةُ / الخُروج","ar":"رَتِّبِ الكَلِماتِ: أَيْنَ / تَأْشيرَةُ / الخُروجِ"},"options":["أَيْنَ تَأْشيرَةُ الخُروج؟","الخُروج أَيْنَ تَأْشيرَةُ؟","تَأْشيرَةُ الخُروج أَيْنَ؟","الخُروج تَأْشيرَةُ أَيْنَ؟"],"answer":0},{"q":{"en":"Which is a direction word?","ur":"Kaunsa simt ka lafz hai?","ar":"أَيُّ كَلِمَةٍ هِيَ اسْمٌ لِجِهَةٍ؟"},"options":["غَرْب","حَقيبَة","طَعام","فُنْدُق"],"answer":0},{"q":{"en":"What does قَريب mean?","ur":"قَريب ka matlab?","ar":"ما مَعْنى «قَريب»؟"},"options":["near","far","big","small"],"answer":0,"options_ar":["قَليلُ البُعْدِ","كَثيرُ البُعْدِ","كَبيرُ الحَجْمِ","صَغيرُ الحَجْمِ"]}]}]}