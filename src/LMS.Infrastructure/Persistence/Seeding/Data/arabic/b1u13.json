"],"answer":0,"options_ar":["وَسيلَةُ نَقْلٍ عَلى الطَّريقِ","ثَوْبٌ نَلْبَسُهُ","شَيْءٌ نَقْرَؤُهُ","جَريدَةٌ أَوْ مَجَلَّةٌ"]}]},{"n":8,"title":{"ar":"القِراءَة: مَعْلوماتُ المُسافِر","en":"Reading: traveller information","ur":"Parhna: musafir ki maloomaat"},"intro":{"en":"Read short passages about travellers: their nationality, job, passport and why they travel. Then answer questions about them.","ur":"Musafiron ke baare mein chhote ibaratein parhein: unki qaumiyat, pesha, passport aur safar ki wajah. Phir sawalon ke jawab dein.","ar":"اِقْرَأْ فِقْراتٍ قَصيرَةً عَنْ مُسافِرينَ: جِنْسِيَّتِهِمْ وَمِهْنَتِهِمْ وَجَوازِهِمْ وَسَبَبِ سَفَرِهِمْ. ثُمَّ أَجِبْ عَنِ الأَسْئِلَةِ."},"vocab":[{"ar":"الجِنْسِيَّة","tr":"al-jinsiyya","en":"nationality","ur":"qaumiyat"},{"ar":"المِهْنَة","tr":"al-mihna","en":"profession","ur":"pesha"},{"ar":"رَقْمُ الجَواز","tr":"raqmu l-jawāz","en":"passport number","ur":"passport number"},{"ar":"مُتَزَوِّج","tr":"mutazawwij","en":"married (man)","ur":"shadi shuda (mard)"},{"ar":"مُتَزَوِّجَة","tr":"mutazawwija","en":"married (woman)","ur":"shadi shuda (aurat)"},{"ar":"الأُسْرَة","tr":"al-usra","en":"family","ur":"khandan"},{"ar":"أَطْفال","tr":"aṭfāl","en":"children","ur":"bachche"},{"ar":"مُدَرِّسَة","tr":"mudarrisa","en":"teacher (woman)","ur":"ustani"},{"ar":"مُهَنْدِس","tr":"muhandis","en":"engineer","ur":"engineer"},{"ar":"طَبيب","tr":"ṭabīb","en":"doctor","ur":"doctor"},{"ar":"عُطْلَة","tr":"ʿuṭla","en":"holiday","ur":"chhutti"},{"ar":"جامِعَة","tr":"jāmiʿa","en":"university","ur":"jamia"},{"ar":"هِوايَة","tr":"hiwāya","en":"hobby","ur":"shauq"},{"ar":"سودانِيَّة","tr":"sūdāniyya","en":"Sudanese (woman)","ur":"Sudan ki (aurat)"},{"ar":"شَهْراً","tr":"shahran","en":"for a month","ur":"ek mahina"},{"ar":"شَقَّة","tr":"shaqqa","en":"apartment","ur":"flat"}],"quiz":[{"q":{"en":"What does الجِنْسِيَّة mean?","ur":"الجِنْسِيَّة ka matlab?","ar":"ما مَعْنى «الجِنْسِيَّة»؟"},"options":["nationality","profession","family","hobby"],"answer":0