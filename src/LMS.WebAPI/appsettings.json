{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LmsDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_USER_SECRETS_OR_ENV_VAR_AT_LEAST_32_CHARS",
    "Issuer": "LmsApp",
    "Audience": "LmsUsers",
    "ExpirationMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:4201" ]
  },
  "Smtp": {
    "Host": "",
    "Port": 25,
    "EnableSsl": false,
    "Username": null,
    "Password": null,
    "FromAddress": "no-reply@lms.local",
    "FromName": "LMS"
  },
  "App": {
    "PublicWebUrl": "http://localhost:4201"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
