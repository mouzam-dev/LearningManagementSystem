{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lms-angular",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd lms-angular && npx ng serve --host 127.0.0.1 --port 4201"
      ],
      "port": 4201
    },
    {
      "name": "lms-api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "dotnet run --project src/LMS.WebAPI --urls http://localhost:5117"
      ],
      "port": 5117
    }
  ]
}
